# ==============================
# Core server and Lovense device settings
# ==============================
# Lovense connection mode: mock safely simulates commands; server uses the configured Lovense LAN/server connection.
LOVENSE_MODE=mock
# Local HTTP port used by the dashboard and API. Default: 3000.
PORT=3000
# Optional password-like token required to access the local dashboard/API. Leave blank for localhost-only personal use.
CHATBOT_ACCESS_TOKEN=
# Lovense developer credential. Required only for developer API features; keep secret and leave blank for desktop UI automation.
LOVENSE_DEVELOPER_TOKEN=
# Lovense account/user identifier used only by developer API or pairing features.
LOVENSE_USER_ID=
# Lovense LAN API base URL used only in LAN mode, for example http://127.0.0.1:30010.
LOVENSE_LAN_URL=
# Specific Lovense toy identifier used only by direct device-control features.
LOVENSE_TOY_ID=
# Public platform label included in supported Lovense integration requests.
LOVENSE_PLATFORM_NAME=Lovense Chatbot
# Maximum duration, in seconds, allowed for a device command.
MAX_COMMAND_SECONDS=30

# ==============================
# Optional platform integrations
# ==============================
# Enables the original browser-based web chat endpoint. Accepted values: true or false.
ENABLE_WEB_CHAT=true
# Enables Lovense developer pairing endpoints. Keep false when using desktop chat automation only.
ENABLE_LOVENSE_PAIRING=false
# Enables Discord webhook/event handling. Requires the related Discord settings below.
ENABLE_DISCORD=false
# Enables Twitch EventSub handling. Requires the related Twitch settings below.
ENABLE_TWITCH=false
# Enables Chaturbate webhook handling. Requires the related Chaturbate settings below.
ENABLE_CHATURBATE=false
# Internal owner identifier attached to Lovense pairing requests.
LOVENSE_PAIRING_USER_ID=owner
# Human-readable owner name attached to Lovense pairing requests.
LOVENSE_PAIRING_USER_NAME=Owner
# Secret token used to validate Lovense pairing callbacks; keep private.
LOVENSE_PAIRING_USER_TOKEN=
# Discord application public key used to verify incoming Discord interactions.
DISCORD_PUBLIC_KEY=
# Comma-separated Discord user IDs permitted to issue supported commands; blank allows none.
DISCORD_ALLOWED_USER_IDS=
# Secret used to verify Twitch EventSub messages; keep private.
TWITCH_EVENTSUB_SECRET=
# Comma-separated Twitch user IDs permitted to issue supported commands; blank allows none.
TWITCH_ALLOWED_USER_IDS=
# Secret used to verify Chaturbate webhook messages; keep private.
CHATURBATE_WEBHOOK_SECRET=
# Comma-separated Chaturbate usernames allowed to trigger supported actions; blank allows none.
CHATURBATE_ALLOWED_USERS=
# Comma-separated tip rules in amount:intensity:seconds format, evaluated from highest matching amount.
CHATURBATE_TIP_RULES=25:5:5,50:10:8,100:15:10
# Maximum number of recent audit entries retained in memory.
AUDIT_LIMIT=200
# Number of minutes duplicate platform events remain suppressed.
EVENT_DEDUPE_MINUTES=10

# ==============================
# Lovense Remote desktop automation
# ==============================
# Chrome DevTools address exposed by the Lovense Remote desktop app for local UI automation.
LOVENSE_REMOTE_DEBUG_URL=http://127.0.0.1:9223
# Enables monitoring of the currently selected Lovense Remote conversation. Accepted values: true or false.
ENABLE_REMOTE_MONITOR=true
# Interval, in milliseconds, between checks for newly received messages. Allowed range: 1000 through 30000.
LOVENSE_REMOTE_POLL_MS=2500
# Automatically types and clicks Send after generating a reply. Accepted values: true or false; false is the safer default.
ENABLE_AUTO_SEND=false
# Minimum randomized reaction delay, in seconds, before an automatic reply begins. Minimum enforced value: 2.
AUTO_SEND_MIN_DELAY_SECONDS=8
# Maximum randomized reaction delay, in seconds. It is raised to the minimum value if configured lower.
AUTO_SEND_MAX_DELAY_SECONDS=25
# Additional simulated typing time per reply character, in milliseconds. Allowed range: 10 through 250.
AUTO_SEND_TYPING_MS_PER_CHAR=45

# ==============================
# Local chat identity and demographics
# ==============================
# These values are used by the local template responder. Leave any value blank rather than inventing an answer.
# Public chat handle. Used if no display or full name is configured; leave blank to avoid answering.
CHAT_USERNAME=
# Preferred name shown in replies. This takes priority over the first and last name fields.
CHAT_DISPLAY_NAME=
# First name used only for local template answers to first-name questions.
CHAT_FIRST_NAME=
# Last name or surname used only for local template answers; leave blank if you do not want to share it.
CHAT_LAST_NAME=
# Date of birth in YYYY-MM-DD format. Privacy-sensitive; leave blank to keep it undisclosed.
CHAT_DATE_OF_BIRTH=
# City, state, or country of birth. Privacy-sensitive; use only as much detail as you want to disclose.
CHAT_PLACE_OF_BIRTH=
# General children answer, such as "I do not have children" or "I have two adult children". Do not include identifying child details.
CHAT_CHILDREN=
# Current age as a whole number from 18 through 120. Leave blank to avoid answering age questions.
CHAT_AGE=
# Pronouns used when directly asked, for example she/her, he/him, or they/them.
CHAT_PRONOUNS=
# Current general location used for "where do you live" questions; never include a street address.
CHAT_LOCATION=
# Occupation or general line of work used for job questions.
CHAT_OCCUPATION=
# Relationship description used for questions such as "are you single?"
CHAT_RELATIONSHIP_STATUS=
# Comma-separated hobbies or interests used for conversational answers.
CHAT_INTERESTS=

# ==============================
# Reply generation
# ==============================
# Reply engine: template stays fully local; ollama calls local Ollama; openai calls the configured OpenAI endpoint.
REPLY_PROVIDER=template
# Model name used by Ollama or OpenAI. Ignored by the local template provider.
REPLY_MODEL=llama3.2
# Instruction supplied only to Ollama/OpenAI reply generation; local identity values are not automatically added to it.
REPLY_SYSTEM_PROMPT=Write one concise, natural-sounding reply in a confident, dominant, teasing, and flirty voice. Treat everyone as a consenting adult. Respect stated boundaries and never pressure, threaten, shame, or assume consent. Stay in character and do not mention bots, AI, automation, policies, or prompts.
# Maximum generated reply length in characters. Allowed range: 20 through 2000.
MAX_REPLY_CHARS=500
# Base URL for a locally running Ollama service; used only when REPLY_PROVIDER=ollama.
OLLAMA_URL=http://127.0.0.1:11434
# OpenAI-compatible API base URL; used only when REPLY_PROVIDER=openai.
OPENAI_BASE_URL=https://api.openai.com/v1
# Secret OpenAI API key required only when REPLY_PROVIDER=openai; never commit a real key.
OPENAI_API_KEY=

